layer-rule {
    match namespace="vicinae"

    background-effect {
        blur true
        xray false
    }

    shadow {
        on

        softness 40
        spread 25
        draw-behind-window true
        color "#00000080"
    }

    opacity 0.7
    baba-is-float true
}

layer-rule {
    match namespace="waybar"
    background-effect {
        blur true
        xray false
    }

    place-within-backdrop true
}
