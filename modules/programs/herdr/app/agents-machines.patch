+  // A tab follows its agent's session title (opencode titles its terminal
+  // "OC | <session>"). The tab is ours while unnamed or still holding the
+  // name we last gave it, so a hand rename wins; "" gives it back.
+  followTitles(tabs, leads) {
+    this.autoNames ??= JSON.parse(localStorage.getItem("autoNames") ?? "{}");
+    for (const tab of tabs) {
+      const l = leads.get(tab.id);
+      if (!l?.program?.agent) continue;
+      const raw = l.program.key === "opencode" ? (l.title ?? "").replace(/^\s*OC \| /, "") : l.title;
+      const name = clean(raw);
+      if (!name || name === tab.name) continue;
+      if (tab.named && tab.name !== this.autoNames[tab.id]) continue;
+      this.autoNames[tab.id] = name;
+      localStorage.setItem("autoNames", JSON.stringify(this.autoNames));
+      run("tab.rename", { id: tab.id, name });
+    }
+  }
