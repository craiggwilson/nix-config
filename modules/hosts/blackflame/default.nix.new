{ inputs, ... }:
let
  hostname = "blackflame";
  diskoConfig = import ./_disko.nix;
in
{
  substrate.hosts.${hostname} = {
    system = "x86_64-linux";
    nixpkgsConfig.cudaSupport = true;
    users = [ "craig@personal" ];
    tags = [
      "host:${hostname}"
    ];

    requires = [
      "host:${hostname}"

      # Hardware model: provided by the system76-serval-ws module. The leaves
      # are named here (and on unsouled's analogue) because capability
      # requires filter rather than pull — the model module never joins if
      # the roots do not name what it concretely configures.
      "hardware:model:system76-serval-ws"
      "hardware:audio"
      "hardware:bluetooth"
      "hardware:camera"
      "hardware:graphics:cuda"
      "hardware:graphics:nvidia"
      "hardware:laptop"
      "hardware:networking"
      "hardware:thunderbolt"

      # System services local to this machine.
      "boot:systemd"
      "networking:dns"
      "hardware:printing"
      "location:raeford"
      "hardware:scanning"

      # Core: minimal cross-class utilities and interfaces, named
      # specifically (there is no bare-core sweep or aggregator). The
      # utils:network tools ride the core:utils prefix sweep.
      "core:home"
      "core:interfaces"
      "core:nix"
      "core:session"
      "core:ssh"
      "core:systemd"
      "core:utils"
      "core:xdg"

      # Platform maintenance lives in the hardware domain, not core.
      "hardware:firmware"
      "hardware:power"
      "hardware:storage"
    ];
  };
  };

  substrate.modules.hosts.${hostname} = {
    tags = [ "host:${hostname}" ];

    nixos =
      { config, ... }:
      {
        imports = [
          inputs.disko.nixosModules.disko
          diskoConfig
        ];

        secretspec.entries = {
          nextDnsBlockedProfile = {
            description = "NextDNS profile id for the malware-blocking configuration.";
            ref = {
              vault = "Craig";
              item = "NextDNS";
              field = "blocked-profile";
            };
            file = { };
          };
          nextDnsUnblockedProfile = {
            description = "NextDNS profile id for the unblocked configuration.";
            ref = {
              vault = "Craig";
              item = "NextDNS";
              field = "unblocked-profile";
            };
            file = { };
          };
        };
        hdwlinux.networking.dns.providers = [
          {
            nextdns = {
              name = "nextdns-blocked";
              secretPath = config.secretspec.entries.nextDnsBlockedProfile.file.path;
            };
          }
          {
            nextdns = {
              name = "nextdns-unblocked";
              secretPath = config.secretspec.entries.nextDnsUnblockedProfile.file.path;
            };
          }
          { cloudflare.name = "cloudflare"; }
        ];

        hdwlinux.theme.system = "catppuccin";
        system.stateVersion = "23.05";
      };
  };
}
